# ── LLM (required — pick one backend) ────────────────────────────────────────

# Option A: Local Ollama (default, zero cost)
# docker-compose.full.yml runs Ollama automatically; or install from https://ollama.com
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:1.5b"   # ~1 GB; use qwen3:14b for best quality

# Option B: Groq — free tier, very fast, no credit card needed
# Get a key at https://console.groq.com (takes 2 minutes)
# OPENAI_API_KEY="gsk_..."
# OLLAMA_BASE_URL="https://api.groq.com/openai/v1"
# OLLAMA_MODEL="llama-3.1-8b-instant"   # or llama-3.3-70b-versatile

# Option C: Google Gemini — free tier (1 000 req/day)
# Get a key at https://aistudio.google.com
# OPENAI_API_KEY="AIza..."
# OLLAMA_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# OLLAMA_MODEL="gemini-1.5-flash"

# Option D: OpenAI
# OPENAI_API_KEY="sk-..."
# OLLAMA_BASE_URL="https://api.openai.com/v1"
# OLLAMA_MODEL="gpt-4o-mini"

OPENAI_API_KEY=

# ── Web search ─────────────────────────────────────────────────────────────────
# Web and Reddit search use DuckDuckGo through the ddgs library. No key needed.

# ── Source enrichment (optional) ──────────────────────────────────────────────
GITHUB_TOKEN=       # improves GitHub search results
YOUTUBE_API_KEY=    # required only for YouTube transcript source

# ── Email delivery (optional) ──────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# ── Performance ────────────────────────────────────────────────────────────────
MAX_RESULTS_PER_SOURCE="5"
MAX_CONCURRENT_REQUESTS="5"
CACHE_EXPIRY_HOURS="24"
REQUEST_TIMEOUT="30"
LOG_LEVEL="INFO"

# ── Local RAG ──────────────────────────────────────────────────────────────────
# legacy = scan ./knowledge_base on every run (default); hybrid = Chroma + BM25 chunks from the index
# built with `python -m src.tools.rag_index`
RAG_MODE="legacy"
RAG_TOP_K="8"
# Optional cross-encoder rerank of the hybrid top-N (needs RAG_MODE=hybrid). Serve it on a GPU host with
#   python scripts/rerank_server.py --port 8099
# Unset = off. If the service is down or slow the RRF order is kept.
# RERANK_URL="http://host.docker.internal:8099/rerank"
# RERANK_CANDIDATES="30"
# RERANK_TIMEOUT="15"
# Optional external books library searched by local_rag (GET <url>/api/search?q=...&top_k=N).
# When set, the local knowledge checkbox starts checked; USE_RAG_DEFAULT overrides that.
# BOOKS_RAG_URL="http://host.docker.internal:8765"
# BOOKS_RAG_TIMEOUT="45"
# USE_RAG_DEFAULT="true"
